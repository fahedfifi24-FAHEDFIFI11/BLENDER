back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
crouch={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194326)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
