; Ashen Hollow — a complete third-person dark fantasy prototype.
config_version=5

[application]
config/name="Ashen Hollow"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/description="A wandering sword. A village without bells. A short dark fantasy action RPG."
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=2048
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.035, 0.048, 0.07, 1)

[physics]
common/physics_ticks_per_second=60

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemies"

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
dodge={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194326)]}
light_attack={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
heavy_attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
block={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":2)]}
lock_on={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194306)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}

[audio]
driver/enable_input=false
